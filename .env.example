# Database connection string
DATABASE_DSN=postgres://loader:1234@localhost:5434/truecode_db?sslmode=disable

# Speech recognition provider: "mock" or "salute"
SPEECH_PROVIDER=mock

# LLM provider: "mock" or "gigachat"
LLM_PROVIDER=mock

# API keys (required only when using real providers)
# SALUTE_SPEECH_KEY=your_salute_key
# GIGA_CHAT_KEY=your_gigachat_key

# Default user ID for CLI mode
# USER_ID=1

# Path to migrations directory (relative to working directory)
# MIGRATIONS_PATH=migrations

# MongoDB GridFS (optional, for storing audio files)
# MONGODB_DSN=mongodb://admin:1234@127.0.0.1:27017
# MONGODB_DATABASE=ContentStore
# MONGODB_BUCKET=Content
